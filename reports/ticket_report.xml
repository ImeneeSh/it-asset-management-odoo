<odoo>
    <record id="action_report_ticket" model="ir.actions.report">
        <field name="name">Fiche d'intervention</field>
        <field name="model">it.ticket</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">it_asset_management.report_ticket_document</field>
        <field name="report_file">it_asset_management.report_ticket_document</field>
        <field name="print_report_name">'Fiche_Intervention_%s' % (object.name)</field>
        <field name="binding_model_id" ref="model_it_ticket"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_ticket_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Fiche d'intervention</h2>
                        <p><strong>Titre :</strong> <span t-esc="doc.name"/></p>
                        <p><strong>Équipement :</strong> <span t-esc="doc.equipment_id.name"/></p>
                        <p><strong>Statut :</strong> <span t-esc="doc.state"/></p>
                        <p><strong>Date de création :</strong> <span t-esc="doc.date_created"/></p>
                        <p><strong>Description :</strong></p>
                        <p t-esc="doc.description"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
