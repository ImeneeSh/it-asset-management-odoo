<odoo>
    <!-- Vue formulaire -->
    <record id="view_it_equipment_form" model="ir.ui.view">
        <field name="name">it.equipment.form</field>
        <field name="model">it.equipment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_tickets" type="object" class="oe_stat_button" icon="fa-wrench">
                            <field name="ticket_count" widget="statinfo" string="Tickets"/>
                        </button>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="equipment_type"/>
                        <field name="serial_number"/>
                        <field name="purchase_date"/>
                        <field name="is_active"/>
                    </group>
                    <notebook>
                        <page string="Tickets d'intervention">
                            <field name="ticket_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="state"/>
                                    <field name="date_created"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue liste -->
    <record id="view_it_equipment_list" model="ir.ui.view">
        <field name="name">it.equipment.list</field>
        <field name="model">it.equipment</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="equipment_type"/>
                <field name="serial_number"/>
                <field name="is_active"/>
            </tree>
        </field>
    </record>

    <!-- Action : le lien entre le menu et les vues -->
    <record id="action_it_equipment" model="ir.actions.act_window">
        <field name="name">Équipements</field>
        <field name="res_model">it.equipment</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu racine (l'app elle-même) -->
    <menuitem id="menu_it_asset_root" name="Parc Informatique" sequence="10"/>

    <!-- Sous-menu qui pointe vers l'action -->
    <menuitem id="menu_it_equipment" name="Équipements" parent="menu_it_asset_root" action="action_it_equipment" sequence="10"/>
</odoo>
