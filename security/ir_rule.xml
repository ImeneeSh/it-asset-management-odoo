<odoo>
    <record id="rule_ticket_technician_own" model="ir.rule">
        <field name="name">Technicien : voir uniquement ses tickets assignés</field>
        <field name="model_id" ref="model_it_ticket"/>
        <field name="domain_force">[('technician_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_it_technician'))]"/>
    </record>
</odoo>
